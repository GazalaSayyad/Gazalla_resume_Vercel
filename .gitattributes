 
# Normalize all text files to LF
* text=auto eol=lf

# Explicit rules for project files
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.toml text eol=lf
*.md   text eol=lf

# Binary files untouched
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary